{
  "name": "danmachat",
  "version": "1.3.0",
  "description": "DanmaChat: fullscreen live chat overlay and Danmaku for YouTube, for Chrome and Firefox",
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "lint:firefox": "node scripts/lint-firefox.js",
    "test": "node --test tests/*.test.mjs",
    "test:firefox": "web-ext run --source-dir dist/firefox",
    "check": "npm test && npm run lint && npm run build && npm run lint:firefox",
    "perf": "node scripts/perf/profile.mjs"
  },
  "keywords": [
    "youtube",
    "chat",
    "danmaku",
    "live-chat-overlay",
    "fullscreen-chat",
    "bullet-comments",
    "extension",
    "firefox",
    "chrome"
  ],
  "author": "khanhnkq",
  "license": "MIT",
  "devDependencies": {
    "eslint": "10.14.0",
    "web-ext": "10.8.0"
  }
}
